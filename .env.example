# Postgres (Prisma) — your existing/self-hosted Postgres
DATABASE_URL=postgresql://user:password@host:5432/oceantune?sslmode=require

# Auth (NextAuth v4)
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# R2 Storage (mvcdn.cc) — see https://panel.mvcdn.cc
# Create a PUBLIC bucket named "oceantune-web-storage" and an access key
# scoped to that bucket. Set bucket CORS origins to your app origin(s).
# R2_ENDPOINT must end with /s3
R2_ENDPOINT=https://mvcdn.cc/s3
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oceantune-web-storage
R2_PUBLIC_URL=https://mvcdn.cc/s3/oceantune-web-storage
R2_ADMIN_URL=https://panel.mvcdn.cc

# Seed admin user (used by `npm run db:seed`, one-time)
ADMIN_EMAIL=admin@oceantune.com
ADMIN_PASSWORD=changeme123

# Telegram contact form notifications (BotFather token + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=